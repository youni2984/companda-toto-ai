PORT=3000
CACHE_TTL_MS=600000
# 실시간 경기/배당/선수/최근폼/맞대결 JSON 공급 API
LIVE_PROVIDER_URL=
LIVE_PROVIDER_TOKEN=

# 2026 선수집/이적/방출/부상/결장 공급 API
# 응답 기본형: { source, teams:[{ id,name,country,league,sport,season,record,players,transfers }] }
ROSTER_PROVIDER_URL=
ROSTER_PROVIDER_TOKEN=
ROSTER_SEASON=2026
ROSTER_REFRESH_MS=300000
ROSTER_STORAGE_PATH=./data/roster-2026.json
# roster-server.js를 별도 서비스로 실행할 때 사용
ROSTER_PORT=3100

# Kakao Developers > 앱 키 > JavaScript 키 (허용 도메인 등록 필요)
KAKAO_JS_KEY=
